<Window
    x:Class="NayfWindows.AuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vayme">

    <!-- Transparent root so the window's Base-acrylic backdrop shows through,
         exactly like the companion panel. The window is sized to fit content. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <StackPanel x:Name="ContentStack" Width="380"
                    HorizontalAlignment="Left" VerticalAlignment="Top">

            <!-- Top bar: close button, matching the panel -->
            <Grid Padding="14,12,12,0">
                <Button x:Name="CloseButton" Click="CloseButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="26" Height="26" CornerRadius="13" Padding="0"
                        Background="#14FFFFFF" BorderThickness="0">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE711;" FontSize="11" Foreground="#8E8E93"/>
                </Button>
            </Grid>

            <StackPanel Padding="40,2,40,34" Spacing="15">

                <!-- Logo + wordmark -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,2,0,2">
                    <Image x:Name="LogoImage" Width="36" Height="36"/>
                    <TextBlock Text="Vayme"
                               Foreground="White" FontSize="24" FontWeight="SemiBold"
                               FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="SubtitleText"
                           Text="Sign in to continue"
                           Foreground="#8E8E93" FontSize="13"
                           FontFamily="{StaticResource UiFont}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <!-- Email -->
                <StackPanel Spacing="7">
                    <TextBlock Text="EMAIL"
                               Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="80" FontFamily="{StaticResource UiFont}"/>
                    <!-- The vertical padding is what centres the text, not
                         VerticalContentAlignment: WinUI's TextBox and PasswordBox
                         templates position both the text and the placeholder from
                         Padding alone and never bind VerticalContentAlignment, so
                         with 0 here the text sits against the top of the box. -->
                    <TextBox x:Name="EmailBox"
                             PlaceholderText="you@example.com" FontSize="14"
                             Height="40" CornerRadius="10" Padding="12,9,12,9"
                             Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="7">
                    <TextBlock Text="PASSWORD"
                               Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="80" FontFamily="{StaticResource UiFont}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 PlaceholderText="••••••••" FontSize="14"
                                 Height="40" CornerRadius="10" Padding="12,9,12,9"
                                 Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                </StackPanel>

                <!-- Error / info message -->
                <TextBlock x:Name="MessageText"
                           Text=""
                           Foreground="#FF453A" FontSize="12"
                           FontFamily="{StaticResource UiFont}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- Primary action -->
                <Button x:Name="SubmitButton"
                        Content="Sign In"
                        HorizontalAlignment="Stretch" Height="42"
                        CornerRadius="10" Click="SubmitButton_Click"
                        Foreground="White" FontSize="14" FontWeight="SemiBold"
                        FontFamily="{StaticResource UiFont}">
                    <Button.Background>
                        <SolidColorBrush Color="#0A84FF"/>
                    </Button.Background>
                </Button>

                <!-- Mode toggle -->
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="ToggleHintText"
                               Text="Don't have an account?"
                               Foreground="#8E8E93" FontSize="12"
                               FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                    <HyperlinkButton x:Name="ToggleModeButton"
                                     Content="Create one"
                                     FontSize="12" Padding="0"
                                     Click="ToggleModeButton_Click"/>
                </StackPanel>

                <ProgressRing x:Name="LoadingRing"
                              IsActive="False"
                              Width="22" Height="22"
                              HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
