<Window
    x:Class="NayfWindows.CompanionPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nayf">

    <!-- Transparent root so the window's acrylic backdrop shows through. The
         content stack is top/left-aligned and the window is sized to fit it. -->
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush Color="Transparent"/>
        </Grid.Background>

        <StackPanel x:Name="ContentStack"
                    Width="368"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="22,16,22,16"
                    Spacing="14">

            <!-- Header: status dot + name + live status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#34C759"/>
                    <TextBlock Text="Nayf"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="HeaderStatusText"
                           Grid.Column="1"
                           Text="Active"
                           Foreground="#8E8E93"
                           FontSize="12"
                           FontWeight="Medium"
                           FontFamily="Segoe UI Variable"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Push-to-talk hint -->
            <TextBlock Text="Hold Ctrl + Alt to talk."
                       Foreground="#B0B0B5"
                       FontSize="13"
                       FontWeight="Medium"
                       FontFamily="Segoe UI Variable"/>

            <!-- Last transcript (what the user said) -->
            <TextBlock x:Name="LastTranscriptText"
                       Text=""
                       Foreground="#8E8E93"
                       FontSize="12"
                       FontFamily="Segoe UI Variable"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"/>

            <!-- Microphone permission banner -->
            <Border x:Name="MicPermissionBanner"
                    CornerRadius="10"
                    Padding="14,12,14,12"
                    Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="#3A2A00"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FF9F0A"/>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness>0.5</Thickness>
                </Border.BorderThickness>

                <StackPanel Spacing="10">
                    <TextBlock Text="Nayf needs speech recognition turned on to hear you."
                               Foreground="White"
                               FontSize="13"
                               FontFamily="Segoe UI Variable"
                               TextWrapping="Wrap"/>
                    <Button x:Name="OpenSpeechSettingsButton"
                            Content="Open Speech Settings"
                            HorizontalAlignment="Stretch"
                            Click="OpenSpeechSettingsButton_Click"
                            Foreground="White"
                            FontSize="13"
                            FontFamily="Segoe UI Variable">
                        <Button.Background>
                            <SolidColorBrush Color="#FF9F0A"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Streaming response text (latest AI response) -->
            <Border x:Name="ResponseContainer"
                    CornerRadius="10"
                    Padding="14,12,14,12"
                    Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="#1E1E20"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#3A3A3C"/>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness>0.5</Thickness>
                </Border.BorderThickness>

                <TextBlock x:Name="ResponseDisplayText"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="13"
                           FontFamily="Segoe UI Variable"
                           LineHeight="19"
                           MaxLines="8"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- Agent task steps — visible when running an agentic loop -->
            <Border x:Name="AgentTaskContainer"
                    CornerRadius="10"
                    Padding="14,12,14,12"
                    Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="#1C1C1E"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#3A3A3C"/>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness>0.5</Thickness>
                </Border.BorderThickness>

                <StackPanel Spacing="8">
                    <TextBlock Text="Working…"
                               Foreground="#8E8E93"
                               FontSize="11"
                               FontFamily="Segoe UI Variable"
                               FontWeight="SemiBold"
                               CharacterSpacing="80"/>
                    <ListView x:Name="AgentStepsList"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0,2,0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#3A3A3C" Opacity="0.5"/>

            <!-- Model selector — segmented toggle -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Model"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Medium"
                           FontFamily="Segoe UI Variable"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        CornerRadius="7"
                        Padding="2"
                        HorizontalAlignment="Right">
                    <Border.Background>
                        <SolidColorBrush Color="#26000000"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#22FFFFFF"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>0.5</Thickness>
                    </Border.BorderThickness>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="SonnetSeg"
                                Content="Sonnet"
                                Tag="claude-sonnet-4-6"
                                Click="ModelSeg_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="5"
                                Padding="14,5,14,5"
                                FontSize="12"
                                FontWeight="Medium"
                                FontFamily="Segoe UI Variable"/>
                        <Button x:Name="OpusSeg"
                                Content="Opus"
                                Tag="claude-opus-4-6"
                                Click="ModelSeg_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="5"
                                Padding="14,5,14,5"
                                FontSize="12"
                                FontWeight="Medium"
                                FontFamily="Segoe UI Variable"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Clear history button -->
            <Button x:Name="ClearHistoryButton"
                    Content="Clear Conversation"
                    HorizontalAlignment="Stretch"
                    Click="ClearHistoryButton_Click"
                    Foreground="#C5C5CA"
                    FontSize="13"
                    FontFamily="Segoe UI Variable"
                    CornerRadius="8"
                    Padding="12,9,12,9">
                <Button.Background>
                    <SolidColorBrush Color="#1FFFFFFF"/>
                </Button.Background>
            </Button>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#3A3A3C" Opacity="0.5"/>

            <!-- Account: signed-in user + inline sign out -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="AccountEmailText"
                           Text=""
                           Foreground="#8E8E93"
                           FontSize="12"
                           FontFamily="Segoe UI Variable"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <HyperlinkButton x:Name="SignOutButton"
                                 Grid.Column="1"
                                 Content="Sign out"
                                 Click="SignOutButton_Click"
                                 Foreground="#FF6B6B"
                                 FontSize="12"
                                 FontFamily="Segoe UI Variable"
                                 Padding="4,0,0,0"/>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#3A3A3C" Opacity="0.5"/>

            <!-- Footer: Quit + shortcut hint -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <HyperlinkButton x:Name="QuitButton"
                                 Content="Quit Nayf"
                                 Click="QuitButton_Click"
                                 Foreground="#8E8E93"
                                 FontSize="12"
                                 FontFamily="Segoe UI Variable"
                                 Padding="0"/>

                <TextBlock Grid.Column="1"
                           Text="Ctrl + Alt — push to talk"
                           Foreground="#48484A"
                           FontSize="11"
                           FontFamily="Segoe UI Variable"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
