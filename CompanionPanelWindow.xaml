<Window
    x:Class="NayfWindows.CompanionPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vayme">

    <!-- Transparent root so the window's acrylic backdrop shows through. The
         content stack is top/left-aligned and the window is sized to fit it. -->
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush Color="Transparent"/>
        </Grid.Background>

        <!-- ═══════════ Design tokens ═══════════
             One place for the palette, so text tiers and surface fills stay
             consistent instead of drifting into a dozen near-identical greys. -->
        <Grid.Resources>
            <SolidColorBrush x:Key="TextPrimary"   Color="#F5F5F7"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A1A1A6"/>
            <SolidColorBrush x:Key="TextTertiary"  Color="#6E6E73"/>
            <SolidColorBrush x:Key="AccentLink"    Color="#0A84FF"/>
            <SolidColorBrush x:Key="Danger"        Color="#FF6B6B"/>

            <!-- Surfaces, lightest to strongest -->
            <SolidColorBrush x:Key="SurfaceLow"  Color="#0AFFFFFF"/>
            <SolidColorBrush x:Key="SurfaceMid"  Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="Hairline"    Color="#14FFFFFF"/>


            <!-- A flat row action: icon + label, no chrome until hovered. -->
            <Style x:Key="BarAction" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="9,6,9,6"/>
            </Style>

            <!-- A round icon-only button (close, quit). -->
            <Style x:Key="RoundIconButton" TargetType="Button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{StaticResource SurfaceMid}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- A small-caps heading that groups settings rows. -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="120"/>
                <Setter Property="Margin" Value="2,0,0,0"/>
            </Style>

            <!-- The card a single settings row sits in. -->
            <Style x:Key="SettingsRow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceLow}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="14,10,12,10"/>
            </Style>

            <!-- A cursor-colour dot. The selection ring is drawn by setting
                 BorderBrush from code (UpdateCursorColorSelection). -->
            <Style x:Key="ColorDot" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
        </Grid.Resources>

        <StackPanel x:Name="ContentStack"
                    Width="480"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

            <!-- ───────────── Header ───────────── -->
            <Grid Padding="24,16,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- On Home: the wordmark. On a subpage it's swapped for a back
                     button + page title, since there are no tabs to return with. -->
                <TextBlock x:Name="HeaderWordmark" Text="Vayme"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold"
                           FontFamily="{StaticResource UiFont}"
                           CharacterSpacing="20" VerticalAlignment="Center"/>

                <StackPanel x:Name="HeaderBackArea" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="BackButton" Click="BackButton_Click"
                            Style="{StaticResource RoundIconButton}"
                            Width="26" Height="26" CornerRadius="13">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE72B;" FontSize="11"
                                  Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                    <TextBlock x:Name="PageTitleText" Text="Memory"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="14" FontWeight="SemiBold"
                               FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status pill -->
                <Border x:Name="StatusPill" Grid.Column="1" CornerRadius="11"
                        Padding="9,4,11,4" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceLow}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#34C759"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderStatusText" Text="Active"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                   FontWeight="Medium" FontFamily="{StaticResource UiFont}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="SettingsButton" Click="SettingsButton_Click"
                            Style="{StaticResource RoundIconButton}"
                            ToolTipService.ToolTip="Settings">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE713;" FontSize="12"
                                  Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Style="{StaticResource RoundIconButton}">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE711;" FontSize="11"
                                  Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ───────────── HOME PAGE ─────────────
                 One hero action. The cursor colours and secondary destinations
                 that used to sit in a second column now live in the bar below,
                 which is what removed the panel's empty right half. -->
            <Grid x:Name="HomePage" Padding="24,4,24,14">
                <Button x:Name="TapToTalkButton" Click="TapToTalkButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{StaticResource SurfaceLow}" BorderThickness="0"
                        CornerRadius="14" Padding="16,14,16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="44" Height="44" VerticalAlignment="Center">
                            <Ellipse x:Name="MicCircle" Width="44" Height="44" Fill="#2E458FFF"/>
                            <FontIcon x:Name="MicGlyph" FontFamily="{StaticResource IconFont}"
                                      Glyph="&#xE720;" FontSize="19" Foreground="#458FFF"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0"
                                    VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TapToTalkLabel" Text="Tap to talk"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="17" FontWeight="SemiBold"
                                       FontFamily="{StaticResource UiFont}"/>
                            <TextBlock Text="Ask about anything on your screen"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>

                        <!-- The shortcut sits at the far edge so the row is anchored
                             at both ends instead of pooling all its weight on the left. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <Border CornerRadius="5" Padding="6,3,6,3" Background="{StaticResource SurfaceMid}">
                                <TextBlock Text="Ctrl" FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Consolas" Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                            <TextBlock Text="+" FontSize="10" Foreground="{StaticResource TextTertiary}"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="5" Padding="6,3,6,3" Background="{StaticResource SurfaceMid}">
                                <TextBlock Text="Alt" FontSize="10" FontWeight="SemiBold"
                                           FontFamily="Consolas" Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- ───────────── MEMORY PAGE ───────────── -->
            <StackPanel x:Name="MemoryPage" Padding="24,4,24,16" Spacing="12"
                        Visibility="Collapsed" HorizontalAlignment="Stretch">
                <TextBlock Text="What Vayme remembers about you across sessions."
                           Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                           FontFamily="{StaticResource UiFont}"/>

                <StackPanel x:Name="MemoryEmptyState" Spacing="12" Padding="0,20,0,20"
                            HorizontalAlignment="Stretch">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE81C;" FontSize="28"
                              Foreground="#48484A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vayme will remember details about you as you chat — they'll show up here."
                               Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                               FontFamily="{StaticResource UiFont}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="340"/>
                </StackPanel>

                <ItemsControl x:Name="MemoryList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0AFFFFFF" CornerRadius="10" Padding="12,10,8,10" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xEC92;" FontSize="12"
                                              Foreground="#A1A1A6" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0,0,0"
                                               Foreground="#F5F5F7" FontSize="13" FontFamily="{StaticResource UiFont}"
                                               TextWrapping="Wrap"/>
                                    <!-- Forgets this one fact. Same shape as the trash button on an
                                         agent tile, so the two lists are operated the same way. -->
                                    <Button Grid.Column="2" Tag="{Binding}" Click="MemoryDelete_Click"
                                            Width="26" Height="26" CornerRadius="13" Padding="0"
                                            Margin="6,0,0,0" BorderThickness="0" Background="Transparent"
                                            VerticalAlignment="Top"
                                            ToolTipService.ToolTip="Forget this">
                                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74D;"
                                                  FontSize="11" Foreground="#6E6E73"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <HyperlinkButton x:Name="ClearMemoryButton" Click="ClearMemoryButton_Click"
                                 HorizontalAlignment="Center" Padding="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74D;" FontSize="12"
                                  Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Clear all memory" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12.5" FontFamily="{StaticResource UiFont}"/>
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>

            <!-- ───────────── AGENTS PAGE ─────────────
                 The tasks Vayme has run, as a two-column grid of tiles. Tapping one
                 opens its floating card, where it can be read again or continued. -->
            <StackPanel x:Name="AgentsPage" Padding="24,4,24,16" Spacing="12"
                        Visibility="Collapsed" HorizontalAlignment="Stretch">
                <TextBlock Text="Tasks Vayme has run. Open one to read it again or keep going."
                           Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                           FontFamily="{StaticResource UiFont}"/>

                <StackPanel x:Name="AgentsEmptyState" Spacing="12" Padding="0,20,0,20"
                            HorizontalAlignment="Stretch">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE945;" FontSize="28"
                              Foreground="#48484A" HorizontalAlignment="Center"/>
                    <TextBlock Text="No agent tasks yet."
                               Foreground="{StaticResource TextPrimary}" FontSize="13"
                               FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Ask Vayme to do something on your PC and it'll show up here so you can pick it back up."
                               Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                               FontFamily="{StaticResource UiFont}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="340"/>
                </StackPanel>

                <ItemsControl x:Name="AgentTaskList" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Fixed cells rather than a wrap: two even columns is the
                                 shape the Mac grid has, and tiles that resize with their
                                 text would make the page reflow every time a task lands. -->
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                                   ItemWidth="216" ItemHeight="142"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The tile is the open button; the trash button on top of it
                                 takes its own clicks, so deleting never opens what it removes. -->
                            <Button Tag="{Binding Id}" Click="AgentTaskTile_Click"
                                    Margin="0,0,10,10" Padding="12,11,12,11"
                                    CornerRadius="14" BorderThickness="1"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="{Binding TileFillBrush}"
                                    BorderBrush="{Binding TileBorderBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Border Width="30" Height="30" CornerRadius="9"
                                                HorizontalAlignment="Left"
                                                Background="{Binding ChipFillBrush}">
                                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE945;"
                                                      FontSize="13" Foreground="{Binding AccentBrush}"/>
                                        </Border>
                                        <Button Tag="{Binding Id}" Click="AgentTaskDelete_Click"
                                                Width="24" Height="24" CornerRadius="12" Padding="0"
                                                BorderThickness="0" Background="Transparent"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                ToolTipService.ToolTip="Delete task">
                                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74D;"
                                                      FontSize="11" Foreground="#6E6E73"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,9,0,0"
                                               Foreground="#F5F5F7" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="{StaticResource UiFont}"
                                               TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2" Text="{Binding Summary}" Margin="0,4,0,0"
                                               Foreground="#A1A1A6" FontSize="11.5"
                                               FontFamily="{StaticResource UiFont}"
                                               TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <HyperlinkButton x:Name="ClearAgentsButton" Click="ClearAgentsButton_Click"
                                 HorizontalAlignment="Center" Padding="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74D;" FontSize="12"
                                  Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Clear all agents" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12.5" FontFamily="{StaticResource UiFont}"/>
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>

            <!-- ───────────── CONNECTIONS PAGE ───────────── -->
            <StackPanel x:Name="ConnectionsPage" Padding="24,4,24,16" Spacing="8"
                        Visibility="Collapsed" HorizontalAlignment="Stretch">
                <TextBlock Text="Connect your apps so Vayme can do more for you."
                           Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,2"/>

                <!-- Only shown when a connect/disconnect attempt actually fails. -->
                <TextBlock x:Name="ConnectionsErrorText" Visibility="Collapsed"
                           Foreground="{StaticResource Danger}" FontSize="11.5"
                           FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>

                <!-- Google Calendar. Connection state is server-side against the signed-in
                     account, so this card reflects what the account has connected on any
                     device — the state is read from the Worker, never assumed. -->
                <Border Background="{StaticResource SurfaceLow}" CornerRadius="12" Padding="14,11,14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CalendarIconBackground" Width="34" Height="34" CornerRadius="10"
                                Background="#1A4285F4" VerticalAlignment="Center">
                            <FontIcon x:Name="CalendarIcon" FontFamily="{StaticResource IconFont}"
                                      Glyph="&#xE787;" FontSize="16" Foreground="#4285F4"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Google Calendar" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse x:Name="CalendarConnectedDot" Width="6" Height="6" Fill="#4DD185"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="CalendarStatusText" Text="Read your schedule and create events"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                           FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Connect and Disconnect share the column; exactly one is ever shown. -->
                        <Button Grid.Column="2" x:Name="ConnectCalendarButton" Content="Connect"
                                Click="ConnectCalendarButton_Click" VerticalAlignment="Center"
                                Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                FontFamily="{StaticResource UiFont}" BorderThickness="0"
                                CornerRadius="15" Padding="16,7,16,7"
                                Background="{StaticResource AccentLink}"/>
                        <Button Grid.Column="2" x:Name="DisconnectCalendarButton" Content="Disconnect"
                                Click="DisconnectCalendarButton_Click" VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Foreground="{StaticResource TextSecondary}" FontSize="12.5" FontWeight="SemiBold"
                                FontFamily="{StaticResource UiFont}" BorderThickness="0"
                                CornerRadius="15" Padding="14,7,14,7"
                                Background="{StaticResource SurfaceMid}"/>
                    </Grid>
                </Border>

                <!-- GitHub -->
                <Border Background="{StaticResource SurfaceLow}" CornerRadius="12" Padding="14,11,14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="GitHubIconBackground" Width="34" Height="34" CornerRadius="10"
                                Background="#1AD5D5DA" VerticalAlignment="Center">
                            <FontIcon x:Name="GitHubIcon" FontFamily="{StaticResource IconFont}"
                                      Glyph="&#xE943;" FontSize="16" Foreground="#D5D5DA"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="GitHub" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse x:Name="GitHubConnectedDot" Width="6" Height="6" Fill="#4DD185"
                                         VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="GitHubStatusText" Text="Issues and pull requests"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                           FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="ConnectGitHubButton" Content="Connect"
                                Click="ConnectGitHubButton_Click" VerticalAlignment="Center"
                                Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                FontFamily="{StaticResource UiFont}" BorderThickness="0"
                                CornerRadius="15" Padding="16,7,16,7"
                                Background="{StaticResource AccentLink}"/>
                        <Button Grid.Column="2" x:Name="DisconnectGitHubButton" Content="Disconnect"
                                Click="DisconnectGitHubButton_Click" VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Foreground="{StaticResource TextSecondary}" FontSize="12.5" FontWeight="SemiBold"
                                FontFamily="{StaticResource UiFont}" BorderThickness="0"
                                CornerRadius="15" Padding="14,7,14,7"
                                Background="{StaticResource SurfaceMid}"/>
                    </Grid>
                </Border>

                <!-- Gmail (soon) -->
                <Border Background="{StaticResource SurfaceLow}" CornerRadius="12" Padding="14,11,14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1AEA4335" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE715;" FontSize="16" Foreground="#EA4335"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Gmail" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <TextBlock Text="Read and draft email" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11.5" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceMid}" CornerRadius="11"
                                Padding="11,4,11,4" VerticalAlignment="Center">
                            <TextBlock Text="Soon" Foreground="{StaticResource TextTertiary}" FontSize="11"
                                       FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Slack (soon) -->
                <Border Background="{StaticResource SurfaceLow}" CornerRadius="12" Padding="14,11,14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A611F69" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8BD;" FontSize="16" Foreground="#C084D8"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Slack" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <TextBlock Text="Send and read messages" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11.5" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceMid}" CornerRadius="11"
                                Padding="11,4,11,4" VerticalAlignment="Center">
                            <TextBlock Text="Soon" Foreground="{StaticResource TextTertiary}" FontSize="11"
                                       FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Notion (soon) -->
                <Border Background="{StaticResource SurfaceLow}" CornerRadius="12" Padding="14,11,14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SurfaceMid}" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8A5;" FontSize="16" Foreground="#D5D5DA"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Notion" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <TextBlock Text="Search and create pages" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11.5" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceMid}" CornerRadius="11"
                                Padding="11,4,11,4" VerticalAlignment="Center">
                            <TextBlock Text="Soon" Foreground="{StaticResource TextTertiary}" FontSize="11"
                                       FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ───────────── TOKENS PAGE ─────────────
                 A checkout surface. Nothing is paid for here: naming an amount opens
                 Paddle's page in the browser, and Paddle's webhook credits the tokens.
                 The two views below are the before and after of that hand-off. -->
            <StackPanel x:Name="TokensPage" Padding="24,4,24,16"
                        Visibility="Collapsed" HorizontalAlignment="Stretch">

                <!-- Buying tokens. The user types what they want to spend; the shortcut
                     chips are built in code from NayfTokenPricing so the amounts live in one
                     place instead of being restated in markup. -->
                <StackPanel x:Name="TokensBuyView" Spacing="12">
                    <StackPanel Spacing="7">
                        <TextBlock Text="100k free tokens every month. Buy any amount on top — tokens never expire."
                                   Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                   FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource SurfaceLow}" CornerRadius="11"
                                Padding="10,4,10,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="TokenBalancePillText" Text="Loading tokens…"
                                       Foreground="{StaticResource TextTertiary}" FontSize="11"
                                       FontWeight="Medium" FontFamily="{StaticResource UiFont}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="HOW MUCH TO SPEND" Style="{StaticResource SectionLabel}"/>

                        <!-- The "$" is drawn beside the field rather than typed into it, so
                             what the user edits is only ever a number. The hint to its right
                             carries both halves of the feedback — what the amount buys, or
                             why it won't go through — because they are never both true and
                             two separate lines would leave a hole in the layout. -->
                        <Border Background="{StaticResource SurfaceLow}" CornerRadius="12"
                                Padding="14,10,14,10">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="$" Foreground="{StaticResource TextSecondary}"
                                           FontSize="22" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="AmountField" Grid.Column="1" Width="88"
                                         Text="5.00" TextChanged="AmountField_TextChanged"
                                         InputScope="Number" MaxLength="8"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="22" FontWeight="SemiBold"
                                         FontFamily="{StaticResource UiFont}"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AmountHintText" Grid.Column="2"
                                           Foreground="{StaticResource TextTertiary}" FontSize="12"
                                           FontFamily="{StaticResource UiFont}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="QuickPickRow" Orientation="Horizontal" Spacing="8"/>
                    </StackPanel>

                    <!-- Automatic top-up. The same amount on the recurring Paddle price
                         instead of the one-time one, which is the only thing this changes. -->
                    <Border Background="{StaticResource SurfaceLow}" CornerRadius="12"
                            Padding="14,10,14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Top up automatically every month"
                                           Foreground="{StaticResource TextPrimary}" FontSize="13"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Buys the same amount each month. Cancel any time."
                                           Foreground="{StaticResource TextTertiary}" FontSize="11"
                                           FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoTopUpSwitch" Grid.Column="1"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="AutoTopUpSwitch_Toggled"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BuyButton" Click="BuyButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Foreground="White" FontSize="13" FontWeight="SemiBold"
                            FontFamily="{StaticResource UiFont}" BorderThickness="0"
                            CornerRadius="12" Padding="14,10,14,10"
                            Background="{StaticResource AccentLink}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="BuySpinner" Width="15" Height="15"
                                          IsActive="False" Visibility="Collapsed"
                                          Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BuyButtonText" Text="Buy 1M tokens — $5.00"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="CheckoutErrorText" Visibility="Collapsed"
                               Foreground="{StaticResource Danger}" FontSize="11.5"
                               FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>

                    <!-- Right of withdrawal. Required to sit on the surface the purchase
                         is made on, as a direct control with no forms to fill in
                         (Swedish Konsumentverket rule). Three exclusive states. -->
                    <Button x:Name="WithdrawalTriggerButton" Click="WithdrawalTriggerButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{StaticResource SurfaceLow}" BorderThickness="0"
                            CornerRadius="12" Padding="12,9,12,9">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE10E;" FontSize="12"
                                      Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Cancel a purchase (right of withdrawal)"
                                       Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                       FontWeight="Medium" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                    </Button>

                    <Border x:Name="WithdrawalConfirmCard" Visibility="Collapsed"
                            Background="{StaticResource SurfaceLow}" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Withdraw from a recent purchase"
                                       Foreground="{StaticResource TextPrimary}" FontSize="13"
                                       FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <TextBlock Text="If you bought within the last 14 days, you can withdraw and request a full refund. You'll get an automatic confirmation of receipt; we then review it and issue any refund through Paddle. Tokens already used may affect the amount."
                                       Foreground="{StaticResource TextTertiary}" FontSize="11"
                                       FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WithdrawalErrorText" Visibility="Collapsed"
                                       Foreground="{StaticResource Danger}" FontSize="10.5"
                                       FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="WithdrawalCancelButton" Content="Not now"
                                        Click="WithdrawalCancelButton_Click"
                                        Foreground="{StaticResource TextSecondary}" FontSize="12"
                                        FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                                        BorderThickness="0" CornerRadius="15" Padding="14,7,14,7"
                                        Background="{StaticResource SurfaceMid}"/>
                                <Button x:Name="WithdrawalSubmitButton" Content="Submit withdrawal request"
                                        Click="WithdrawalSubmitButton_Click"
                                        Foreground="White" FontSize="12" FontWeight="SemiBold"
                                        FontFamily="{StaticResource UiFont}" BorderThickness="0"
                                        CornerRadius="15" Padding="14,7,14,7"
                                        Background="{StaticResource AccentLink}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="WithdrawalAcknowledgedCard" Visibility="Collapsed"
                            Background="#1A0A84FF" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE930;" FontSize="14"
                                          Foreground="{StaticResource AccentLink}"/>
                                <TextBlock Text="Request received"
                                           Foreground="{StaticResource TextPrimary}" FontSize="13"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                            <TextBlock x:Name="WithdrawalAcknowledgmentText"
                                       Foreground="{StaticResource TextTertiary}" FontSize="11"
                                       FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                            <!-- Selectable: the reference is the only handle the user has
                                 on the request if they need to chase it. -->
                            <TextBlock x:Name="WithdrawalReferenceText" Visibility="Collapsed"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource TextTertiary}" FontSize="10"
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                            <Button x:Name="WithdrawalDoneButton" Content="Done"
                                    Click="WithdrawalDoneButton_Click" HorizontalAlignment="Left"
                                    Foreground="White" FontSize="12" FontWeight="SemiBold"
                                    FontFamily="{StaticResource UiFont}" BorderThickness="0"
                                    CornerRadius="15" Padding="16,7,16,7"
                                    Background="{StaticResource AccentLink}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Payments processed securely by Paddle. You have a 14-day right of withdrawal on purchases."
                               Foreground="{StaticResource TextTertiary}" FontSize="10"
                               FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- After the browser opens. Payment happens where this app can't see it,
                     so the user tells us when it's done and the balance is re-read. -->
                <StackPanel x:Name="TokensCheckoutView" Visibility="Collapsed" Spacing="12"
                            Padding="0,16,0,8" HorizontalAlignment="Stretch">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE774;" FontSize="28"
                              Foreground="{StaticResource AccentLink}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Finish your purchase in the browser"
                               Foreground="{StaticResource TextPrimary}" FontSize="14"
                               FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Once you've paid, tap below — your balance updates in a few seconds."
                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                               FontFamily="{StaticResource UiFont}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="PurchaseCompletedButton" Content="I've completed my purchase"
                            Click="PurchaseCompletedButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Foreground="White" FontSize="13" FontWeight="SemiBold"
                            FontFamily="{StaticResource UiFont}" BorderThickness="0"
                            CornerRadius="10" Padding="0,11,0,11"
                            Background="{StaticResource AccentLink}"/>
                    <Button x:Name="BackToAmountButton" Content="Back"
                            Click="BackToAmountButton_Click" HorizontalAlignment="Center"
                            Style="{StaticResource BarAction}"
                            Foreground="{StaticResource TextTertiary}" FontSize="11"
                            FontFamily="{StaticResource UiFont}"/>
                </StackPanel>
            </StackPanel>

            <!-- ───────────── SETTINGS PAGE ───────────── -->
            <StackPanel x:Name="SettingsPage" Padding="24,4,24,16" Spacing="14"
                        Visibility="Collapsed" HorizontalAlignment="Stretch">

                <StackPanel Spacing="7">
                    <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}"/>

                    <!-- Vayme shows and tells what it can do. First row of the first section
                         because it is the answer to the question a new user actually has. -->
                    <Button x:Name="CapabilitiesRow" Click="CapabilitiesButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="{StaticResource SurfaceLow}" BorderThickness="0"
                            CornerRadius="12" Padding="14,10,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xEA80;" FontSize="15"
                                      Foreground="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center" Width="22"/>
                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="What can Vayme do?"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"/>
                                <TextBlock Text="Vayme talks you through it"
                                           Foreground="{StaticResource TextTertiary}"
                                           FontSize="11" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" FontFamily="{StaticResource IconFont}" Glyph="&#xE76C;"
                                      FontSize="10" Foreground="{StaticResource TextTertiary}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Roast mode. A tone setting and only a tone setting: Vayme is exactly
                         as useful with it on, it is just markedly less polite about the
                         state of your desktop. -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE899;" FontSize="15"
                                      Foreground="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center" Width="22"/>
                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Roast mode"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"/>
                                <TextBlock Text="Same help, considerably less politeness"
                                           Foreground="{StaticResource TextTertiary}"
                                           FontSize="11" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="RoastModeToggle" Grid.Column="2"
                                          Toggled="RoastModeToggle_Toggled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Launch at sign-in. This is the same HKCU Run entry the
                         installer offers to create, so the two stay in agreement. -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE7E8;" FontSize="15"
                                      Foreground="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center" Width="22"/>
                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Start Vayme when I sign in"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"/>
                                <TextBlock Text="Vayme is ready the moment Windows is"
                                           Foreground="{StaticResource TextTertiary}"
                                           FontSize="11" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2"
                                          Toggled="StartupToggle_Toggled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Speech recognition lives in Windows Settings, not in Vayme. -->
                    <Button x:Name="SpeechSettingsRow" Click="OpenSpeechSettingsButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="{StaticResource SurfaceLow}" BorderThickness="0"
                            CornerRadius="12" Padding="14,10,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE720;" FontSize="15"
                                      Foreground="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center" Width="22"/>
                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Microphone &amp; speech"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"/>
                                <TextBlock Text="Manage speech recognition in Windows Settings"
                                           Foreground="{StaticResource TextTertiary}"
                                           FontSize="11" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" FontFamily="{StaticResource IconFont}" Glyph="&#xE76C;"
                                      FontSize="10" Foreground="{StaticResource TextTertiary}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Updates. Vayme installs these itself while nothing is going on, so
                         this row is mostly a status line — it says what it is doing, and
                         gives the user a way to make it happen now rather than wait. -->
                    <Button x:Name="UpdateRow" Click="UpdateRow_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="{StaticResource SurfaceLow}" BorderThickness="0"
                            CornerRadius="12" Padding="14,10,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE777;" FontSize="15"
                                      Foreground="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center" Width="22"/>
                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="UpdateRowTitle" Text="Check for updates"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"/>
                                <TextBlock x:Name="UpdateRowCaption"
                                           Text="Vayme keeps itself up to date automatically"
                                           Foreground="{StaticResource TextTertiary}"
                                           FontSize="11" FontFamily="{StaticResource UiFont}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ProgressRing x:Name="UpdateRowSpinner" Grid.Column="2" IsActive="False"
                                          Visibility="Collapsed" Width="16" Height="16"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}"/>

                    <!-- Drops the in-memory conversation Vayme carries between turns. -->
                    <Button x:Name="ClearHistoryButton" Click="ClearHistoryButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="{StaticResource SurfaceLow}" BorderThickness="0"
                            CornerRadius="12" Padding="14,10,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE74D;" FontSize="15"
                                      Foreground="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center" Width="22"/>
                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Clear conversation history"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"/>
                                <TextBlock x:Name="ClearHistoryCaption"
                                           Text="Forget what we've talked about this session"
                                           Foreground="{StaticResource TextTertiary}"
                                           FontSize="11" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock Text="Saved memories are separate — clear those from the Memory page."
                               Foreground="{StaticResource TextTertiary}" FontSize="11"
                               FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"
                               Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Text="ACCOUNT" Style="{StaticResource SectionLabel}"/>

                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,10,0">
                                <TextBlock Text="Signed in as"
                                           Foreground="{StaticResource TextTertiary}"
                                           FontSize="11" FontFamily="{StaticResource UiFont}"/>
                                <TextBlock x:Name="AccountEmailText" Text="—"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource UiFont}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="SignOutButton" Grid.Column="1" Content="Sign out"
                                    Click="SignOutButton_Click" VerticalAlignment="Center"
                                    Foreground="{StaticResource Danger}" FontSize="12.5"
                                    FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                                    Background="{StaticResource SurfaceMid}" BorderThickness="0"
                                    CornerRadius="15" Padding="15,7,15,7"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="VersionText" Text="Vayme for Windows"
                           Foreground="{StaticResource TextTertiary}" FontSize="10.5"
                           FontFamily="{StaticResource UiFont}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- ───────────── DYNAMIC AREA (banners / prompts) ─────────────
                 Only things the user has to act on: a permission that needs granting, a
                 command that needs approving. Nothing of the conversation itself lives
                 here — not what the user said, not what Vayme answered, and not a running
                 account of what Vayme did to arrive at it. Vayme speaks its answers; the
                 panel is the controls, not a transcript. -->
            <StackPanel x:Name="DynamicArea" Padding="24,0,24,8" Spacing="10">
                <!-- Speech-unavailable banner. Both the sentence and the button are set
                     from the reason Windows gave, because "turn on online speech
                     recognition", "let desktop apps use the microphone" and "this PC's
                     speech language cannot be dictated" are three different pages of
                     Settings, and sending someone to the wrong one is worse than silence. -->
                <Border x:Name="MicPermissionBanner" CornerRadius="12" Padding="14,12,14,12" Visibility="Collapsed"
                        Background="#332600" BorderBrush="#66FF9F0A" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="MicPermissionMessage"
                                   Text="Vayme needs speech recognition turned on to hear you."
                                   Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                        <Button x:Name="OpenSpeechSettingsButton" Content="Open Speech Settings"
                                HorizontalAlignment="Stretch" Click="FixSpeechProblemButton_Click"
                                Foreground="#1C1C1E" FontSize="13" FontWeight="SemiBold"
                                FontFamily="{StaticResource UiFont}" BorderThickness="0"
                                CornerRadius="10" Padding="0,9,0,9" Background="#FF9F0A"/>
                    </StackPanel>
                </Border>

                <!-- Agent confirmation prompt: a question put to the user, not an answer
                     given to them. It is the only thing here that carries Vayme's words,
                     and it is here because there is no way to answer it otherwise. -->
                <Border x:Name="AgentConfirmContainer" CornerRadius="12" Padding="14,12,14,12" Visibility="Collapsed"
                        Background="#33140F" BorderBrush="#66FF453A" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Allow Vayme to run this command?" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
                            <!-- Why this particular command needs approval. Without it the user
                                 is asked to judge a wall of shell syntax with nothing to go on. -->
                            <TextBlock x:Name="AgentConfirmReason" Text="" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Background="#22000000" CornerRadius="8" Padding="10,8,10,8">
                            <TextBlock x:Name="AgentConfirmCommand" Text="" Foreground="#FFB0A8" FontSize="11"
                                       FontFamily="Consolas" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AgentDenyButton" Grid.Column="0" Content="Deny" HorizontalAlignment="Stretch"
                                    Click="AgentDenyButton_Click" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                    FontFamily="{StaticResource UiFont}" BorderThickness="0" CornerRadius="10"
                                    Padding="0,8,0,8" Background="{StaticResource SurfaceMid}"/>
                            <Button x:Name="AgentApproveButton" Grid.Column="2" Content="Allow" HorizontalAlignment="Stretch"
                                    Click="AgentApproveButton_Click" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                    FontFamily="{StaticResource UiFont}" BorderThickness="0" CornerRadius="10"
                                    Padding="0,8,0,8" Background="#FF453A"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ───────────── ACTION BAR ─────────────
                 Secondary destinations on the left, cursor colour on the right.
                 Mirrors the Mac panel's bottom action row. -->
            <Rectangle Height="1" Fill="{StaticResource Hairline}"/>
            <Grid Padding="18,8,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ConnectAppsButton" Click="ConnectAppsButton_Click" Style="{StaticResource BarAction}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE71B;" FontSize="13"
                                      Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="ConnectAppsLabel" Text="Connect apps"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12.5" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MemoryButton" Click="MemoryButton_Click" Style="{StaticResource BarAction}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE81C;" FontSize="13"
                                      Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Memory" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12.5" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AgentsButton" Click="AgentsButton_Click" Style="{StaticResource BarAction}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE945;" FontSize="13"
                                      Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="Agents" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12.5" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            ToolTipService.ToolTip="Cursor colour">
                    <Button x:Name="ColorBlue" Tag="Blue" Click="CursorColor_Click" Style="{StaticResource ColorDot}">
                        <Ellipse Width="13" Height="13"><Ellipse.Fill><SolidColorBrush Color="#458FFF"/></Ellipse.Fill></Ellipse>
                    </Button>
                    <Button x:Name="ColorRed" Tag="Red" Click="CursorColor_Click" Style="{StaticResource ColorDot}">
                        <Ellipse Width="13" Height="13"><Ellipse.Fill><SolidColorBrush Color="#FF5252"/></Ellipse.Fill></Ellipse>
                    </Button>
                    <Button x:Name="ColorYellow" Tag="Yellow" Click="CursorColor_Click" Style="{StaticResource ColorDot}">
                        <Ellipse Width="13" Height="13"><Ellipse.Fill><SolidColorBrush Color="#FFC72E"/></Ellipse.Fill></Ellipse>
                    </Button>
                    <Button x:Name="ColorGreen" Tag="Green" Click="CursorColor_Click" Style="{StaticResource ColorDot}">
                        <Ellipse Width="13" Height="13"><Ellipse.Fill><SolidColorBrush Color="#4DD185"/></Ellipse.Fill></Ellipse>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ───────────── FOOTER (account + meta) ───────────── -->
            <Rectangle Height="1" Fill="{StaticResource Hairline}"/>
            <Grid Padding="24,10,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tokens -->
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE734;" FontSize="11"
                              Foreground="{StaticResource TextTertiary}"/>
                    <TextBlock x:Name="CreditBalanceText" Text="Loading tokens…"
                               Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                               FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                    <HyperlinkButton x:Name="TopUpButton" Content="Top up" Click="TopUpButton_Click"
                                     Foreground="{StaticResource AccentLink}" FontSize="11.5"
                                     FontFamily="{StaticResource UiFont}" Padding="5,0,0,0"/>
                </StackPanel>

                <!-- Routed model (Vayme picks automatically — not user-selectable) -->
                <Border Grid.Column="2" CornerRadius="11" Padding="9,4,11,4" VerticalAlignment="Center"
                        Margin="0,0,8,0" Background="{StaticResource SurfaceLow}"
                        ToolTipService.ToolTip="Vayme routes each request to the right model">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE945;" FontSize="10"
                                  Foreground="{StaticResource TextTertiary}"/>
                        <TextBlock x:Name="ActiveModelText" Text="Auto"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="QuitButton" Grid.Column="3" Click="QuitButton_Click"
                        Style="{StaticResource RoundIconButton}" Width="26" Height="26" CornerRadius="13"
                        Background="{StaticResource SurfaceLow}"
                        ToolTipService.ToolTip="Quit Vayme">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE7E8;" FontSize="11"
                              Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
