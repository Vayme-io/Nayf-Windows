<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NayfWindows</RootNamespace>
    <AssemblyName>NayfWindows</AssemblyName>
    <!-- The taskbar and Explorer label the app with FileDescription, which comes
         from AssemblyTitle. Without these it reads "NayfWindows" (the exe name).
         AssemblyName itself stays put Ã¢â‚¬â€ the installer, the startup Run entry and
         the update scripts all reference NayfWindows.exe. -->
    <AssemblyTitle>Vayme</AssemblyTitle>
    <Product>Vayme</Product>
    <Company>Vayme</Company>
    <!-- Shown on the panel's Settings page. Keep in step with MyAppVersion in
         installer\Nayf.iss so the app and the installer report the same build. -->
    <Version>1.2.1</Version>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Ship the Windows App SDK runtime inside the app rather than expecting it
         on the machine. The publish flag by that name covers .NET only; without
         this the build carries the bootstrapper alone, which looks for a Windows App
         Runtime installed on the machine and, not finding one, puts up "Windows App SDK 2.0 runtime is not
         installed" and exits. That never showed up here because a dev machine has
         it Ã¢â‚¬â€ it is what anyone we hand the installer to would see instead of Vayme. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Tell the SDK our entry point is in Program.cs, not auto-generated -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NayfIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <!-- Copy assets to output -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WORKAROUND: `dotnet publish` for unpackaged WinUI 3 apps drops the compiled
       XAML (*.xbf) and the app resource index (NayfWindows.pri). Without them
       Application.LoadComponent throws XamlParseException at first-window
       creation and the app dies on startup. Copy them from the build output
       ($(OutDir)) into the publish folder so published builds run correctly. -->
  <Target Name="CopyPriAndXbfToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_NayfPriXbf Include="$(OutDir)*.pri" />
      <_NayfPriXbf Include="$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_NayfPriXbf)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="false"
          Condition="'@(_NayfPriXbf)' != ''" />
    <Message Importance="high" Text="Vayme: copied PRI/XBF resources into publish output." />
  </Target>
</Project>
