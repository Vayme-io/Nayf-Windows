<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NayfWindows</RootNamespace>
    <AssemblyName>NayfWindows</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Tell the SDK our entry point is in Program.cs, not auto-generated -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NayfIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <!-- Copy assets to output -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WORKAROUND: `dotnet publish` for unpackaged WinUI 3 apps drops the compiled
       XAML (*.xbf) and the app resource index (NayfWindows.pri). Without them
       Application.LoadComponent throws XamlParseException at first-window
       creation and the app dies on startup. Copy them from the build output
       ($(OutDir)) into the publish folder so published builds run correctly. -->
  <Target Name="CopyPriAndXbfToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_NayfPriXbf Include="$(OutDir)*.pri" />
      <_NayfPriXbf Include="$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_NayfPriXbf)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="false"
          Condition="'@(_NayfPriXbf)' != ''" />
    <Message Importance="high" Text="Nayf: copied PRI/XBF resources into publish output." />
  </Target>
</Project>
