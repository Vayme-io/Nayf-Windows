<Window
    x:Class="NayfWindows.TextInputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ask Vayme">

    <!-- Transparent root so the window's acrylic backdrop shows through, same as
         the companion panel. The stack is measured and the window sized to it. -->
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush Color="Transparent"/>
        </Grid.Background>

        <!-- Same design tokens as CompanionPanelWindow, so the two surfaces read
             as one app rather than two near-identical greys. -->
        <Grid.Resources>
            <SolidColorBrush x:Key="TextPrimary"   Color="#F5F5F7"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A1A1A6"/>
            <SolidColorBrush x:Key="TextTertiary"  Color="#6E6E73"/>
            <SolidColorBrush x:Key="SurfaceMid"    Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="Hairline"      Color="#14FFFFFF"/>
            <x:String x:Key="UiFont">Segoe UI Variable</x:String>
        </Grid.Resources>

        <!-- Aligned rather than stretched: the window is sized from ActualHeight, and a
             stretched stack reports the window's own height back, so the two chase each
             other until the box is as tall as the screen. -->
        <StackPanel x:Name="ContentStack" Width="560" Padding="16,14,16,12" Spacing="9"
                    HorizontalAlignment="Left" VerticalAlignment="Top">

            <!-- Header: what this is, and which chord opened it. -->
            <Grid>
                <TextBlock Text="Ask Vayme" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="Alt + T" Foreground="{StaticResource TextTertiary}"
                           FontSize="11" FontFamily="{StaticResource UiFont}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Background="{StaticResource SurfaceMid}" CornerRadius="12"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    Padding="12,9,12,9">
                <TextBox x:Name="InputBox"
                         PlaceholderText="Type what you need…"
                         Foreground="{StaticResource TextPrimary}"
                         FontSize="14" FontFamily="{StaticResource UiFont}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="24" MaxHeight="132"
                         BorderThickness="0" Padding="0" Background="Transparent">
                    <!-- The stock TextBox paints its own fill and a focus underline.
                         Both fight the card it sits in, so every state is cleared. -->
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground"                  Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver"       Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused"           Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled"          Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush"                 Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"      Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused"          Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled"         Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground"       Color="#6E6E73"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6E6E73"/>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
            </Border>

            <TextBlock Text="Enter to send · Shift+Enter for a new line · Esc to close"
                       Foreground="{StaticResource TextTertiary}"
                       FontSize="11" FontFamily="{StaticResource UiFont}"/>
        </StackPanel>
    </Grid>
</Window>
