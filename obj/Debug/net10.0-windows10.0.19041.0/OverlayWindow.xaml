<Window
    x:Class="NayfWindows.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Transparent root — actual transparency is applied via DWM/layered window in code-behind -->
    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="Transparent">

        <!-- Blue cursor companion — positioned via Canvas.Left/Top, updated by timer -->
        <Canvas x:ConnectionId='3' x:Name="CursorCanvas">

            <!-- The blue glowing triangle cursor -->
            <Grid x:ConnectionId='4' x:Name="CursorContainer">
                <!-- Outer glow ring (semi-transparent blue circle) -->
                <Ellipse x:ConnectionId='18' x:Name="GlowRing"
                         Width="60" Height="60"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="-16,-16,0,0"
                         Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#80007AFF" Offset="0"/>
                            <GradientStop Color="#00007AFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Cursor triangle — the main blue buddy shape -->
                <Path x:ConnectionId='19' x:Name="CursorTriangle"
                      Data="M 0,0 L 18,8 L 0,18 Z"
                      Fill="#FF007AFF"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:ConnectionId='20' x:Name="CursorRotation" Angle="-35"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <!-- Response text bubble — shown during responding state -->
            <Border x:ConnectionId='5' x:Name="ResponseBubble"
                    MaxWidth="380"
                    Padding="14,10,14,10"
                    CornerRadius="12"
                    Opacity="0"
                    Canvas.Left="30"
                    Canvas.Top="-60">
                <Border.Background>
                    <SolidColorBrush Color="#E61C1C1E"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#3A3A3C"/>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness>0.5</Thickness>
                </Border.BorderThickness>
                <TextBlock x:ConnectionId='17' x:Name="ResponseText"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="14"
                           FontFamily="Segoe UI Variable"
                           LineHeight="20"/>
            </Border>

            <!-- Waveform visualization — shown during listening state -->
            <StackPanel x:ConnectionId='6' x:Name="WaveformPanel"
                        Orientation="Horizontal"
                        Spacing="3"
                        Opacity="0"
                        Canvas.Left="25"
                        Canvas.Top="-30">
                <Rectangle x:ConnectionId='12' x:Name="WaveBar1" Width="3" Height="8" RadiusX="2" RadiusY="2" Fill="#FF007AFF"/>
                <Rectangle x:ConnectionId='13' x:Name="WaveBar2" Width="3" Height="14" RadiusX="2" RadiusY="2" Fill="#FF007AFF"/>
                <Rectangle x:ConnectionId='14' x:Name="WaveBar3" Width="3" Height="20" RadiusX="2" RadiusY="2" Fill="#FF007AFF"/>
                <Rectangle x:ConnectionId='15' x:Name="WaveBar4" Width="3" Height="14" RadiusX="2" RadiusY="2" Fill="#FF007AFF"/>
                <Rectangle x:ConnectionId='16' x:Name="WaveBar5" Width="3" Height="8" RadiusX="2" RadiusY="2" Fill="#FF007AFF"/>
            </StackPanel>

            <!-- Spinner — shown during processing state -->
            <ProgressRing x:ConnectionId='7' x:Name="ProcessingSpinner"
                          Width="24" Height="24"
                          Foreground="#FF007AFF"
                          Opacity="0"
                          Canvas.Left="18"
                          Canvas.Top="-36"
                          IsActive="True"/>

            <!-- Navigation/pointing speech bubble -->
            <Border x:ConnectionId='8' x:Name="NavigationBubble"
                    MaxWidth="280"
                    Padding="10,7,10,7"
                    CornerRadius="10"
                    Opacity="0"
                    Canvas.Left="30"
                    Canvas.Top="-50">
                <Border.Background>
                    <SolidColorBrush Color="#CC007AFF"/>
                </Border.Background>
                <TextBlock x:ConnectionId='11' x:Name="NavigationText"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Medium"
                           FontFamily="Segoe UI Variable"/>
            </Border>

            <!-- Sonar pulse ring — shown when pointing at an element -->
            <Ellipse x:ConnectionId='9' x:Name="SonarRing"
                     Stroke="#007AFF"
                     StrokeThickness="2"
                     Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:ConnectionId='10' x:Name="SonarScale" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
    </Grid>
</Window>

