<Application
    x:Class="NayfWindows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Nayf Design System Colors -->
            <Color x:Key="NayfBlue">#FF007AFF</Color>
            <Color x:Key="NayfBackground">#FF1C1C1E</Color>
            <Color x:Key="NayfSurface">#FF2C2C2E</Color>
            <Color x:Key="NayfBorder">#FF3A3A3C</Color>
            <Color x:Key="NayfText">#FFFFFFFF</Color>
            <Color x:Key="NayfSubtext">#FF8E8E93</Color>
            <Color x:Key="NayfGreen">#FF34C759</Color>
            <Color x:Key="NayfRed">#FFFF3B30</Color>

            <SolidColorBrush x:Key="NayfBlueBrush" Color="{StaticResource NayfBlue}"/>
            <SolidColorBrush x:Key="NayfBackgroundBrush" Color="{StaticResource NayfBackground}"/>
            <SolidColorBrush x:Key="NayfSurfaceBrush" Color="{StaticResource NayfSurface}"/>
            <SolidColorBrush x:Key="NayfBorderBrush" Color="{StaticResource NayfBorder}"/>
            <SolidColorBrush x:Key="NayfTextBrush" Color="{StaticResource NayfText}"/>
            <SolidColorBrush x:Key="NayfSubtextBrush" Color="{StaticResource NayfSubtext}"/>
            <SolidColorBrush x:Key="NayfGreenBrush" Color="{StaticResource NayfGreen}"/>
            <SolidColorBrush x:Key="NayfRedBrush" Color="{StaticResource NayfRed}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

